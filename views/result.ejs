<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= data.name || 'Resume' %> &mdash; Resume Reader</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">
    <div class="page-header">
      <a class="back-link" href="/">&larr; Read another resume</a>
      <div class="header-actions">
        <button type="button" id="download-json-btn" class="secondary-btn">Download JSON</button>
        <button type="button" id="download-xml-btn" class="secondary-btn">Download XML</button>
      </div>
    </div>

    <%
      // "description" fields are one string with points joined by "; " —
      // split back out for bullet-list display.
      function bullets(text) {
        if (!text) return [];
        return String(text).split(';').map(function (s) { return s.trim(); }).filter(Boolean);
      }
      var addr = data.address || {};
      var addressLines = [addr.address1, addr.address2, addr.address3].filter(Boolean);
    %>

    <div class="identity-card">
      <p class="full-name"><%= data.name || 'Name not found' %></p>
      <div class="meta-list">
        <% if (addressLines.length) { %>
          <p class="meta-line"><span class="meta-label">Address:</span> <%= addressLines.join(', ') %></p>
        <% } %>
        <% if (data.email) { %>
          <p class="meta-line"><span class="meta-label">Email:</span> <%= data.email %></p>
        <% } %>
        <% if (data.mobile) { %>
          <p class="meta-line"><span class="meta-label">Mobile:</span> <%= data.mobile %></p>
        <% } %>
        <% if (data.passportNo) { %>
          <p class="meta-line"><span class="meta-label">Passport No:</span> <%= data.passportNo %></p>
        <% } %>
        <% if (data.passportExpDt) { %>
          <p class="meta-line"><span class="meta-label">Passport Exp Dt:</span> <%= data.passportExpDt %></p>
        <% } %>
        <% if (data.visaStatus) { %>
          <p class="meta-line"><span class="meta-label">Visa Status:</span> <%= data.visaStatus %></p>
        <% } %>
        <% if (data.links && data.links.length) { %>
          <% data.links.forEach(function(link) { %>
            <% if (link && link.url) { %>
              <p class="meta-line">
                <span class="meta-label"><%= link.label || 'Link' %>:</span>
                <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer"><%= link.url %></a>
              </p>
            <% } %>
          <% }) %>
        <% } %>
        <% if (!addressLines.length && !data.email && !data.mobile && !data.passportNo && !data.passportExpDt && !data.visaStatus && !(data.links && data.links.length)) { %>
          <p class="meta-line missing">No contact details found.</p>
        <% } %>
      </div>
    </div>

    <section class="record-section">
      <h2>Education</h2>
      <% if (data.education && data.education.length) { %>
        <ul class="record-list">
          <% data.education.forEach(function(edu) { %>
            <li class="record-entry">
              <div class="entry-top">
                <div>
                  <div class="entry-title"><%= edu.board || 'Institution' %></div>
                  <div class="entry-org"><%= edu.country || '' %></div>
                </div>
                <div class="entry-dates"><%= edu.year || '' %></div>
              </div>
              <% if (bullets(edu.description).length) { %>
                <ul class="entry-desc">
                  <% bullets(edu.description).forEach(function(point) { %>
                    <li><%= point %></li>
                  <% }) %>
                </ul>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="empty-note">No education entries found.</p>
      <% } %>
    </section>

    <% if (data.experience && data.experience.length) { %>
    <section class="record-section">
      <h2>Experience</h2>
        <ul class="record-list">
          <% data.experience.forEach(function(role) { %>
            <li class="record-entry">
              <div class="entry-top">
                <div>
                  <div class="entry-title"><%= role.designation || 'Role' %></div>
                  <div class="entry-org"><%= [role.company, role.state, role.country].filter(Boolean).join(', ') %></div>
                </div>
                <div class="entry-dates"><%= [role.periodFrom, role.periodTo].filter(Boolean).join(' \u2013 ') %></div>
              </div>
              <% if (role.responsibility && role.responsibility.length) { %>
                <ul class="entry-desc">
                  <% role.responsibility.forEach(function(point) { %>
                    <li><%= point %></li>
                  <% }) %>
                </ul>
              <% } %>
            </li>
          <% }) %>
        </ul>
    </section>
    <% } %>

    <% if (data.certifications && data.certifications.length) { %>
    <section class="record-section">
      <h2>Certifications</h2>
        <ul class="record-list">
          <% data.certifications.forEach(function(cert) { %>
            <li class="record-entry">
              <div class="entry-top">
                <div>
                  <div class="entry-title"><%= cert.board || 'Certification' %></div>
                  <div class="entry-org"><%= cert.country || '' %></div>
                </div>
                <div class="entry-dates"><%= cert.year || '' %></div>
              </div>
              <% if (bullets(cert.description).length) { %>
                <ul class="entry-desc">
                  <% bullets(cert.description).forEach(function(point) { %>
                    <li><%= point %></li>
                  <% }) %>
                </ul>
              <% } %>
            </li>
          <% }) %>
        </ul>
    </section>
    <% } %>

    <% if (data.achievements && data.achievements.length) { %>
    <section class="record-section">
      <h2>Achievements</h2>
        <ul class="record-list">
          <% data.achievements.forEach(function(ach) { %>
            <li class="record-entry">
              <div class="entry-top">
                <div>
                  <div class="entry-title"><%= ach.board || 'Achievement' %></div>
                  <div class="entry-org"><%= ach.country || '' %></div>
                </div>
                <div class="entry-dates"><%= ach.year || '' %></div>
              </div>
              <% if (bullets(ach.description).length) { %>
                <ul class="entry-desc">
                  <% bullets(ach.description).forEach(function(point) { %>
                    <li><%= point %></li>
                  <% }) %>
                </ul>
              <% } %>
            </li>
          <% }) %>
        </ul>
    </section>
    <% } %>

  </div>

  <script id="resume-data" type="application/json"><%- JSON.stringify(data) %></script>
  <script id="resume-xml" type="text/plain"><%- xml %></script>
  <script>
    (function () {
      var data = JSON.parse(document.getElementById('resume-data').textContent);
      var xml = document.getElementById('resume-xml').textContent;
      var jsonBtn = document.getElementById('download-json-btn');
      var xmlBtn = document.getElementById('download-xml-btn');

      function safeFilename() {
        var name = (data.name || 'resume').trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        return name || 'resume';
      }

      function triggerDownload(content, mimeType, filename) {
        var blob = new Blob([content], { type: mimeType });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      }

      jsonBtn.addEventListener('click', function () {
        triggerDownload(JSON.stringify(data, null, 2), 'application/json', safeFilename() + '.json');
      });

      xmlBtn.addEventListener('click', function () {
        triggerDownload(xml, 'application/xml', safeFilename() + '.xml');
      });
    })();
  </script>
</body>
</html>
